# Пример настроек. Скопируйте в .env и подставьте свой пароль.
# Файл .env в git не попадает.
DB_NAME=todo
DB_USER=todo
DB_PASSWORD=change-me

# Порт фронтенда на хосте (слушает только 127.0.0.1)
FRONTEND_PORT=8080

# Число процессов gunicorn в контейнере бэкенда
WEB_CONCURRENCY=4

# Лимиты ресурсов (задание со звёздочкой). Значения по умолчанию подобраны
# под нагрузку из REPORT.md, их можно переопределить здесь или в командной строке.
BACKEND_CPUS=2.0
BACKEND_MEMORY=128m
DB_CPUS=2.0
DB_MEMORY=128m
FRONTEND_CPUS=0.5
FRONTEND_MEMORY=64m
